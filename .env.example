# Copy to .env. docker-compose.yml reads this file (env_file) and passes it to Directus.

# Host port Directus is published on. Keep PUBLIC_URL and the CORS origin in sync with it.
DIRECTUS_PORT=8055

# Directus
SECRET=dev-secret-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
PUBLIC_URL=http://localhost:8055
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db
WEBSOCKETS_ENABLED=true

# Lets the playground app (apps/playground) call Directus from the browser
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Dev: reload extensions when their dist changes, don't cache the app bundle
EXTENSIONS_AUTO_RELOAD=true
EXTENSIONS_CACHE_TTL=1s
CACHE_ENABLED=false

# @shilp.dev/directus-google-auth (see packages/directus-google-auth/README.md)
SHILP_GOOGLE_AUTH_CLIENT_ID=
SHILP_GOOGLE_AUTH_CLIENT_SECRET=
SHILP_GOOGLE_AUTH_REDIRECT_ALLOW_LIST=http://localhost:3000

# @shilp.dev/directus-ai-content-generator (see packages/ai-content-generator/README.md)
# Set the token and models of each provider you use. Models: comma separated, the first one is the default.
SHILP_AI_CONTENT_GENERATOR_CLAUDE_TOKEN=
SHILP_AI_CONTENT_GENERATOR_CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
SHILP_AI_CONTENT_GENERATOR_GEMINI_TOKEN=
SHILP_AI_CONTENT_GENERATOR_GEMINI_MODELS=gemini-3.8-flash

# @shilp.dev/directus-counter (see packages/counter/README.md)
# Comma separated collection.field entries: the numeric field to increment in each collection.
SHILP_COUNTER_ALLOW_LIST=memes.views,origins.views
