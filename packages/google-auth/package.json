{
  "name": "@shilp.dev/directus-google-auth",
  "description": "Google authentication for custom frontends, allowing users to sign in or register as regular Directus users using their Google accounts.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "7Span (https://7span.com)",
  "homepage": "https://github.com/shilpdev/directus-extensions/tree/main/packages/google-auth#readme",
  "bugs": {
    "url": "https://github.com/shilpdev/directus-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shilpdev/directus-extensions.git",
    "directory": "packages/google-auth"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-endpoint",
    "google",
    "oauth",
    "login"
  ],
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^16.0.0",
    "@types/node": "^22.0.0",
    "jose": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
