{
  "name": "@shilp.dev/directus-ai-content-generator",
  "description": "Flow operation that generates content (descriptions, summaries, copy) with AI providers like Claude and Gemini, from a prompt and a set of variables.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "7Span (https://7span.com)",
  "homepage": "https://github.com/shilpdev/directus-extensions/tree/main/packages/ai-content-generator#readme",
  "bugs": {
    "url": "https://github.com/shilpdev/directus-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shilpdev/directus-extensions.git",
    "directory": "packages/ai-content-generator"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "ai",
    "claude",
    "gemini",
    "google",
    "anthropic",
    "content-generation"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "operation",
        "name": "ai-content-generator",
        "source": {
          "app": "src/operation/app.ts",
          "api": "src/operation/api.ts"
        }
      },
      {
        "type": "endpoint",
        "name": "ai-content-generator-endpoint",
        "source": "src/endpoint/index.ts"
      },
      {
        "type": "interface",
        "name": "ai-content-generator-model-select",
        "source": "src/interface/index.ts"
      }
    ],
    "host": "^11.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@directus/extensions-sdk": "^16.0.0",
    "@google/genai": "^3.6.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
