{
  "name": "@shilp.dev/vue-google-auth",
  "version": "0.0.1",
  "description": "Headless Google OAuth components for Vue. You write the markup, the components handle the login flow and session state.",
  "keywords": [
    "vue",
    "nuxt",
    "google",
    "oauth",
    "auth",
    "login",
    "headless"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
